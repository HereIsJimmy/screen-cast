# Folder(s) with your videos. Separate several paths with commas (";" on Windows if a path already contains a comma).
MEDIA_DIRS=C:\Users\your-user\Videos

# Folder where remuxed videos and extracted subtitles are stored (cache).
CACHE_DIR=./.cache

# Server port (API + web).
PORT=4000

# If you have local certificates (see the README, HTTPS with mkcert section), the web app is also
# served over HTTPS on a separate port (PORT+1 by default, or whatever you set in HTTPS_PORT) — only
# so you can control casting from your phone/another PC. The TV always gets the videos over plain HTTP.
HTTPS_KEY=
HTTPS_CERT=
# HTTPS_PORT=4001

# If a video isn't Chromecast-compatible (unusual video/audio codec) and this is "true", the
# server transcodes it with ffmpeg (slower, uses CPU). If "false", it's only repackaged (remux)
# without re-encoding, and casting an incompatible video will fail.
ALLOW_TRANSCODE=true

# Video file extensions to index.
VIDEO_EXTENSIONS=.mp4,.mkv,.webm,.mov,.m4v,.avi

# By default, scanning only reads/indexes (ffprobe) videos modified in the last N months — so
# scanning stays fast even with a large, old library. The web app can turn this filter off to see
# (and play) older videos too.
RECENT_MONTHS=3

# Shows (and enables) a "Shut down the server PC" button in Settings > Miscellaneous. Off by
# default. If you turn it on, SHUTDOWN_PASSWORD must be set too — if it's left empty, the button
# still won't work even with SHUTDOWN_ENABLED set to "true".
SHUTDOWN_ENABLED=false
# Password the web app asks for before shutting down. Without it, shutdown stays disabled.
SHUTDOWN_PASSWORD=
