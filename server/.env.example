# Carpeta(s) con tus vídeos. Varias rutas separadas por comas (";" en Windows si la ruta ya lleva coma).
MEDIA_DIRS=C:\Users\tu-usuario\Videos

# Carpeta donde se guardan los vídeos remuxados y los subtítulos extraídos (cache).
CACHE_DIR=./.cache

# Puerto del servidor (API + web).
PORT=4000

# Si tienes certificados locales (ver README, sección HTTPS con mkcert), la web se sirve además
# por HTTPS en un puerto aparte (PORT+1 por defecto, o el que pongas en HTTPS_PORT) — solo para
# poder controlar el cast desde el móvil/otro PC. La TV siempre recibe los vídeos por HTTP normal.
HTTPS_KEY=
HTTPS_CERT=
# HTTPS_PORT=4001

# Si un vídeo no es compatible con Chromecast (códec de vídeo/audio raro) y esto es "true",
# el servidor lo transcodifica con ffmpeg (más lento, usa CPU). Si es "false", solo se
# reempaqueta (remux) sin recodificar, y si no es compatible, casear ese vídeo fallará.
ALLOW_TRANSCODE=true

# Extensiones de archivo de vídeo a indexar.
VIDEO_EXTENSIONS=.mp4,.mkv,.webm,.mov,.m4v,.avi

# Por defecto, el escaneo solo lee/indexa (ffprobe) los vídeos modificados en los últimos N meses
# — así el escaneo es rápido aunque tengas una biblioteca grande y antigua. Desde la web se puede
# desactivar este filtro para ver (y probar) también los vídeos más antiguos.
RECENT_MONTHS=3

# Muestra (y habilita) un botón "Apagar el PC del servidor" en Configuración > Varios. Desactivado
# por defecto. Si lo activas, SHUTDOWN_PASSWORD también debe estar definida — si se deja vacía, el
# botón seguirá sin funcionar aunque SHUTDOWN_ENABLED sea "true".
SHUTDOWN_ENABLED=false
# Contraseña que se pide en la web antes de apagar. Sin ella, el apagado permanece deshabilitado.
SHUTDOWN_PASSWORD=
